PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/nextpr
FRONTEND_URL=http://localhost:3000

# GitHub OAuth app: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/auth/github/callback

# Personal access token (no scopes needed) used by the crawler. Strongly recommended for rate limits.
GITHUB_TOKEN=

# Generate: openssl rand -hex 32   (JWT_SECRET)  /  openssl rand -hex 32  (ENCRYPTION_KEY, must be 64 hex chars)
JWT_SECRET=
ENCRYPTION_KEY=
ADMIN_KEY=

# Optional
CRAWL_CRON=0 * * * *
CRAWL_LANGUAGES=
